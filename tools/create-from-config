#!/usr/bin/env bash
#
# Reads config from $CONFIGS/topics and $CONFIGS/acls
# and creates the specified topics and ACLs.

source "$TOOLS_BIN/lib/logging.sh"

TOOLS="${STACK_PATH}/tools"

log_info "Applying Kafka topics…"
for file in "$CONFIGS/topics/"*.yml "$CONFIGS/topics/"*.yaml; do
  [ -e "$file" ] || continue

  topic=$(yq -r '.topic' "$file")
  partitions=$(yq -r '.partitions' "$file")
  replication=$(yq -r '.replication_factor' "$file")

  if ! "$TOOLS/kafka-topics" --list \
        | sed 's/\r$//' \
        | grep -qx "$topic"; then

    log_info "Creating topic: $topic"
    "$TOOLS/kafka-topics" \
      --create \
      --topic "$topic" \
      --partitions "$partitions" \
      --replication-factor "$replication"
  else
    log_info "Topic already exists: $topic"
  fi
done

log_info "Applying Kafka ACLs…"
for file in "$CONFIGS/acls/"*.yml "$CONFIGS/acls/"*.yaml; do
  [ -e "$file" ] || continue

  principal=$(yq -r '.principal' "$file")
  group=$(yq -r '.group' "$file")

  mapfile -t topics < <(yq -r '.topics[]' "$file")
  mapfile -t perms < <(yq -r '.permissions[]' "$file")

  for topic in "${topics[@]}"; do
    for perm in "${perms[@]}"; do
      if ! "$TOOLS/kafka-acls" --list --topic "$topic" | grep -q "principal=$principal"; then
        log_info "Applying ACL: $perm on $topic for $principal"
        "$TOOLS/kafka-acls" \
          --add \
          --allow-principal "$principal" \
          --"$perm" \
          --topic "$topic" \
          --group "$group"
      else
        log_info "ACL already exists: $perm on $topic for $principal"
      fi
    done
  done
done
